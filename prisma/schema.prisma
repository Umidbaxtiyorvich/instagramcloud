generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  locale       String   @default("uz")
  mcpToken     String   @unique
  // "chat": the AI asks in the chat and acts; "dashboard": every write waits for «Ha» in Tasdiqlar
  aiApproval   String   @default("chat")
  createdAt    DateTime @default(now())

  accounts    InstagramAccount[]
  approvals   Approval[]
  uploads     MediaUpload[]
  oauthCodes  OAuthCode[]
  oauthTokens OAuthToken[]
  mcpServers  McpServer[]
}

// AI Ofis agentlari ishlatadigan tashqi MCP serverlar (Notion, Linear, GitHub ...).
// auth: "none" | "token" (foydalanuvchi bergan API token) | "oauth" (server bilan OAuth 2.1 + PKCE)
model McpServer {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  url             String
  auth            String    @default("none")
  enabled         Boolean   @default(true)
  // false: agentlar faqat readOnlyHint=true vositalarni ishlatadi (yozish tasdiqsiz ketmasin)
  allowWrites     Boolean   @default(false)
  // [{ name, description, readOnly }] — oxirgi tekshiruvdagi tools/list
  toolsJson       String?
  checkedAt       DateTime?
  lastError       String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  // OAuth: dinamik ro'yxatdan o'tgan mijoz va server manzillari
  oauthClientId   String?
  oauthClientSecretEnc String?
  oauthTokenUrl   String?
  oauthAuthUrl    String?
  oauthScope      String?
  oauthVerifierEnc String?
  oauthState      String?   @unique
  createdAt       DateTime  @default(now())

  @@unique([userId, name])
}

model InstagramAccount {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId            String
  username            String
  name                String?
  profilePic          String?
  followersCount      Int       @default(0)
  accessTokenEnc      String
  tokenExpiresAt      DateTime?
  isDemo              Boolean   @default(false)
  dmAutoReplyEnabled  Boolean   @default(true)
  defaultDmReply      String    @default("")
  defaultDmMode       String    @default("first")
  commentRepliesOn    Boolean   @default(true)
  connectedAt         DateTime  @default(now())
  mediaSyncedAt       DateTime?
  // last time Meta delivered a webhook for this account; null = auto-replies can't fire yet
  lastWebhookAt       DateTime?

  rules         AutoRule[]
  logs          ActivityLog[]
  media         MediaItem[]
  conversations Conversation[]
  optOuts       OptOut[]
  approvals     Approval[]

  @@unique([userId, igUserId])
}

model AutoRule {
  id            String            @id @default(cuid())
  accountId     String
  account       InstagramAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          String
  keywords      String
  matchMode     String            @default("contains")
  scope         String            @default("all")
  mediaIds      String            @default("[]")
  dmMessage     String
  publicReplies String            @default("[]")
  enabled       Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model OptOut {
  id             String           @id @default(cuid())
  accountId      String
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igScopedUserId String
  createdAt      DateTime         @default(now())

  @@unique([accountId, igScopedUserId])
}

model ActivityLog {
  id         String           @id @default(cuid())
  accountId  String
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       String
  direction  String
  username   String?
  igUserId   String?
  text       String
  replyText  String?
  mediaId    String?
  commentId  String?
  messageId  String?
  createdAt  DateTime         @default(now())
}

model MediaItem {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igMediaId   String
  mediaType   String
  caption     String           @default("")
  permalink   String           @default("")
  thumbnail   String           @default("")
  timestamp   DateTime?
  views       Int              @default(0)
  reach       Int              @default(0)
  shares      Int              @default(0)
  saves       Int              @default(0)
  likes       Int              @default(0)
  comments    Int              @default(0)
  avgWatchSec Int              @default(0)

  @@unique([accountId, igMediaId])
}

model Conversation {
  id             String           @id @default(cuid())
  accountId      String
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igScopedUserId String
  username       String
  lastMessage    String
  lastAt         DateTime         @default(now())
  firstContactAt DateTime         @default(now())
  lastAutoReply  DateTime?

  @@unique([accountId, igScopedUserId])
}

model Approval {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  toolName  String
  summary   String
  payload   String
  status    String            @default("pending")
  result    String?
  createdAt DateTime          @default(now())
  decidedAt DateTime?
}

// OAuth 2.1 for the MCP connector (Claude, ChatGPT): clients register themselves (RFC 7591),
// the user signs in on this site and approves, the client gets a token for /mcp.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String   @default("AI")
  redirectUris String
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String      @default("instagram")
  expiresAt     DateTime
  usedAt        DateTime?
}

model OAuthToken {
  id               String      @id @default(cuid())
  accessHash       String      @unique
  refreshHash      String      @unique
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            String      @default("instagram")
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime    @default(now())
}

// Videos and photos uploaded on the site so Instagram can fetch them by URL when publishing.
// The bytes are dropped after publishing; Render's free disk is not persistent, so they live here.
model MediaUpload {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicToken String    @unique
  filename    String
  mimeType    String
  size        Int
  data        Bytes?
  publishedId String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
}
