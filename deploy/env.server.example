# Serverdagi .env — Render → instagramcloud → Environment dagi qiymatlarni shu yerga ko'chiring.
# DATABASE_URL va APP_URL kerak emas: docker-compose.yml o'zi beradi.

# Sayt manzili (setup.sh o'zi qo'yadi: <ip>.sslip.io). O'z domeningiz bo'lsa — shuni yozing.
DOMAIN=
# Yangi baza paroli (setup.sh o'zi yaratadi)
DB_PASSWORD=

# MUHIM: Render'dagi bilan aynan bir xil bo'lsin, aks holda Instagram tokenlari ochilmaydi
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_MODE=instagram
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Miya'ning Telegram boti va akkaunti
MIYA_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=

# To'lov boti (Railway) va YesPOS / CloudShop
TOLOV_BOT_URL=
TOLOV_BOT_API_KEY=
CLOUDSHOP_APP_KEY=
CS_EMAIL=
CS_PASSWORD=
CS_COMPANY_ID=
MOLIYA_ADMIN_EMAILS=

# Video GitHub Actions'da yasalsa
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Umidbaxtiyorvich/instagramcloud
GITHUB_BRANCH=

# Twilio (ixtiyoriy)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
