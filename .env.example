DATABASE_URL="postgresql://user:password@localhost:5432/instagramcloud"
# Public https address of the site (e.g. the cloudflared tunnel). Leave empty to use the request host.
APP_URL=""
AUTH_SECRET="generate-a-long-random-secret"
TOKEN_ENCRYPTION_KEY="32-character-encryption-key!!!!"

# Meta app → "Instagram API with Instagram Login" (no Facebook Page needed)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_OAUTH_MODE="instagram"
# Defaults to APP_URL + /api/instagram/callback
INSTAGRAM_REDIRECT_URI=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="instagramcloud-verify"
GRAPH_API_VERSION="v23.0"

# AI Ofis (/ofis) — agentlar Claude bilan ishlashi uchun
ANTHROPIC_API_KEY=""

# AI Ofis «Moliya» — Telegram to'lov boti (@claudeadminbot_bot) va CloudShop (faqat o'qish)
# Moliyani ko'ra oladigan foydalanuvchilar (vergul bilan)
MOLIYA_ADMIN_EMAILS=""
# CloudShop: botdagi CS_EMAIL / CS_PASSWORD bilan bir xil; ilova kaliti botning cloudshop.py faylidagi APP_KEY
CS_EMAIL=""
CS_PASSWORD=""
CS_COMPANY_ID=""
CLOUDSHOP_APP_KEY=""
# Telegram bot: Railway'dagi ommaviy manzil va botdagi API_KEY
TOLOV_BOT_URL=""
TOLOV_BOT_API_KEY=""

# Miya telefonda — Twilio (console.twilio.com): hisob SID, auth token va sotib olingan raqam (+1...)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_NUMBER=""
# ixtiyoriy: TELEFON_MODEL (bo'sh — OPENAI_MODEL), TELEFON_OVOZ (coral), TELEFON_TTS_MODEL, TELEFON_STT_MODEL
