DATABASE_URL="postgresql://user:password@localhost:5432/instagramcloud"
# Public https address of the site (e.g. the cloudflared tunnel). Leave empty to use the request host.
APP_URL=""
AUTH_SECRET="generate-a-long-random-secret"
TOKEN_ENCRYPTION_KEY="32-character-encryption-key!!!!"

# Meta app → "Instagram API with Instagram Login" (no Facebook Page needed)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_OAUTH_MODE="instagram"
# Defaults to APP_URL + /api/instagram/callback
INSTAGRAM_REDIRECT_URI=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="instagramcloud-verify"
GRAPH_API_VERSION="v23.0"
