DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-secret"
TOKEN_ENCRYPTION_KEY="32-character-encryption-key!!!!"

# INSTAGRAM_OAUTH_MODE="instagram" (instagram.com login):
#   developers.facebook.com -> App -> Instagram -> "API setup with Instagram login"
#   -> "Instagram app ID" / "Instagram app secret". NOT the Meta App ID from the
#   top of the dashboard / Basic settings — that gives "Invalid platform app".
INSTAGRAM_OAUTH_MODE="instagram"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# INSTAGRAM_OAUTH_MODE="facebook" (Facebook Login, IG linked to a Facebook Page):
#   App settings -> Basic -> App ID / App secret.
META_APP_ID=""
META_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="instagramcloud-verify"
GRAPH_API_VERSION="v23.0"
