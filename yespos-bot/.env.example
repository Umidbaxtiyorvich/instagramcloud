# === Telegram ===
# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456:ABC-DEF...
# Botdan foydalana oladigan Telegram ID lar (vergul bilan). ID ni @userinfobot dan bilib olasiz
ADMIN_IDS=123456789

# === YesPOS ===
YESPOS_ORG_ID=
YESPOS_LOGIN=
YESPOS_PASSWORD=
# Filial ID (odatda 1)
YESPOS_BRANCH=1
# Narx turi ID (odatda 1)
YESPOS_PRICE_TYPE=1

# === Ogohlantirish sozlamalari ===
# Mijoz qarzi necha kundan oshsa ogohlantirish (bir nechta bosqich)
DEBT_DAYS=7,15,30
# Sotilmayotgan tovar: necha kun ichida bitta ham sotilmagan
UNSOLD_DAYS=30
# Kam sotilayotgan tovarlar tahlili davri (kun)
SLOW_DAYS=30
# Kunlik hisobot vaqti (Toshkent vaqti)
DAILY_REPORT_TIME=09:00
# Minus tovar tekshiruvi oralig'i (daqiqa)
CHECK_INTERVAL_MIN=60
